# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored — never commit real credentials.

# Required for the "AI Agent 智能進度摘要" feature on the dashboard.
# Without this set, the app still runs — that panel just shows the
# example output instead of calling the live API.
OPENAI_API_KEY=sk-...

# Optional — defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini
